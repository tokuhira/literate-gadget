async getLog() {
  return (await this.ctx.storage.get("log")) ?? [];
}
@

<<記録に一行足す>>=

async note(entry) {
  const log = [...(await this.getLog()), { at: new Date().toISOString(), ...entry }];
  const trimmed = log.slice(-20);
  await this.ctx.storage.put("log", trimmed);
  this.broadcast(trimmed);
  return trimmed;
}
@

