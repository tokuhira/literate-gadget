#!/usr/bin/env perl
# nweave - a minimal noweb-style weaver: .nw -> HTML.
#   usage: nweave file.nw > file.html
use strict; use warnings;
print "<!doctype html><meta charset=utf-8>\n";
print "<style>body{max-width:44em;margin:2em auto;font-family:serif;line-height:1.7}",
      "h1,h2,h3{line-height:1.3;margin:1.8em 0 .6em}",
      "h1{border-bottom:2px solid #ccc;padding-bottom:.2em}",
      "h2{border-bottom:1px solid #ddd;padding-bottom:.15em}",
      "hr{border:0;border-top:1px solid #ddd;margin:2.4em 0}",
      "code{background:#f0f0f0;padding:.1em .3em;border-radius:3px;",
      "font-family:monospace;font-size:.9em}",
      "pre{background:#f4f4f4;padding:.8em;border-left:3px solid #888;font-family:monospace}",
      "pre code{background:none;padding:0}",
      "b.cn{color:#a00}",
      # Evidence. One colour per kind, so the relative strength shows at a glance.
      ".ev{margin:.6em 0;padding:.4em .8em;border-left:4px solid;font-size:.9em}",
      ".ev .k{font-weight:bold;margin-right:.6em}",
      ".ev .src{color:#555;font-family:monospace;font-size:.9em;margin-right:.6em}",
      ".ev-物証{border-color:#2a7;background:#f2faf6}",
      ".ev-証言{border-color:#c92;background:#fdf8ee}",
      ".ev-推理{border-color:#88a;background:#f5f5fa}",
      "</style>\n";
my $in = 0;
while (my $l = <>) {
    if ($l =~ /^<<(.+)>>=\s*$/) {                       # chunk opens
        printf "<pre><b class=cn>&lt;&lt;%s&gt;&gt;=</b>\n", esc($1); $in = 1; next;
    }
    if ($in && $l =~ /^\@\s*$/) { print "</pre>\n"; $in = 0; next; }   # chunk closes
    if ($in) {                                          # inside a chunk
        my $e = esc($l);
        $e =~ s/&lt;&lt;(.+?)&gt;&gt;/<b class=cn>&lt;&lt;$1&gt;&gt;<\/b>/g;
        print $e; next;
    }
    # Evidence. Prose defaults to "unproven"; only these lines carry backing.
    if ($l =~ /^\@証\s+(\S+)\s+(\S+)\s*(.*?)\s*$/) {
        printf "<div class=\"ev ev-%s\"><span class=k>%s</span>" .
               "<span class=src>%s</span>%s</div>\n",
               esc($1), esc($1), esc($2), inline($3);
        next;
    }
    # Prose. Only the markdown this document actually uses is interpreted.
    if ($l =~ /^(#{1,6})\s+(.*?)\s*$/) {                # heading
        my $lv = length $1;
        printf "<h%d>%s</h%d>\n", $lv, inline($2), $lv; next;
    }
    if ($l =~ /^---+\s*$/) { print "<hr>\n"; next; }     # rule
    print $l =~ /^\s*$/ ? "<p>\n" : inline($l);
}
# Escape first, then mark up: anything we emit below must survive as tags.
sub inline {
    my $s = esc(shift);
    $s =~ s/`([^`]+)`/<code>$1<\/code>/g;
    $s =~ s/\*\*(.+?)\*\*/<strong>$1<\/strong>/g;
    return $s;
}
sub esc { my $s = shift; $s =~ s/&/&amp;/g; $s =~ s/</&lt;/g; $s =~ s/>/&gt;/g; $s }
