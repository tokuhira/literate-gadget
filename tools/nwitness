#!/usr/bin/env perl
# nwitness - .nw 文書の証拠を集計する。tangle（綯う）/ weave（織る）に対する第三の操作。
#   usage: nwitness [-a] [-v] file.nw
#          nwitness file.md      本文中の `file.ts:123` 形式の引用を突き合わせる
#          -a  証拠の付いている節も含めて全部出す（既定は未証の節だけ）
#
# 平文の既定は「未証」である。`@証` の行が置かれたところだけ裏付けが付く。
# 緩く使うなら走らせなければよく、ストイックに使えば未証の節が TODO リストになる。
#
# 記法:
#   @証 <種類> <典拠> <記述>
#
#   物証  実際に動かして観察した。典拠は確認した日付
#   証言  出典が述べている。典拠はファイルと位置。**証人も誤りうるし、
#         こちらが適用範囲を取り違えることもある**（HANDOFF.md §2.10 の実例）
#   推理  コードを読んで導いた。典拠は読んだ範囲
#
# 強さは 物証 > 証言 > 推理 だが、物証も「観察」であって「解釈」ではない。
# 何を見たかは確かでも、なぜそうなるかは別に立証が要る。

use strict; use warnings;
use utf8;
binmode(STDOUT, ':encoding(UTF-8)');

my ($all, $verify) = (0, 0);
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $o = shift;
    if    ($o eq '-a') { $all = 1 }
    elsif ($o eq '-v') { $verify = 1 }
    else  { die "nwitness: 不明なオプション $o\n" }
}
my $file = shift or die "usage: nwitness [-a] [-v] file.nw|file.md\n";

my $REF = 'reference/cloudflare-os';

# Markdown は .nw と違い、節に証拠を貼る構造を持たない。拾えるのは本文に
# 散らばった `file.ts:123` という引用だけである。だがそれで足りる。
# 2026-08-10 に腐ったのはまさにこれで、行番号だけがずれて内容は動いていた。
exit check_markdown($file) if $file =~ /\.md$/i;

open(my $fh, '<:encoding(UTF-8)', $file) or die "nwitness: $file: $!\n";

my @sections;                      # { title, line, ev => [...] }
my $cur = { title => '(冒頭)', line => 0, ev => [] };
my $in_chunk = 0;
my @misplaced;                     # チャンクの中に置かれた @証（コードに漏れる）

while (my $l = <$fh>) {
    my $n = $.;
    if ($l =~ /^<<(.+)>>=\s*$/)          { $in_chunk = 1; next; }
    if ($in_chunk && $l =~ /^\@\s*$/)    { $in_chunk = 0; next; }

    if ($in_chunk) {
        # チャンク内の @証 は ntangle に素通しされ、コードに混入する。
        push @misplaced, { line => $n, text => $l } if $l =~ /^\s*\@証\b/;
        next;
    }

    if ($l =~ /^##+\s+(.*?)\s*$/) {      # 節の切れ目
        push @sections, $cur;
        $cur = { title => $1, line => $n, ev => [] };
        next;
    }
    if ($l =~ /^\@証\s+(\S+)\s+(\S+)\s*(.*?)\s*$/) {
        push @{$cur->{ev}}, { kind => $1, src => $2, text => $3, line => $n };
        next;
    }
}
push @sections, $cur;
close $fh;

# ---- 裏取り（-v）----
#
# 証言は「上流がこう言っている」という主張なので、上流が変われば古びる。
# 引用文が本当にその行にあるかを突き合わせる。これが弱点3（証拠の風化）への対処。
#
# 種類ごとに検査できることが違う:
#   証言  引用文がその行に実在するか
#   推理  本文はこちらの推論なので、行が実在するかだけ
#   物証  典拠は日付。突き合わせる相手がない
my @stale;
if ($verify) {
    if (!-d $REF) {
        die "nwitness: $REF がない。裏取りには参照元が要る（setup.sh を先に）\n";
    }
    my %index = build_index($REF);
    for my $s (@sections) {
        for my $e (@{$s->{ev}}) {
            next if $e->{kind} eq '物証';
            my ($name, $from, $to) = $e->{src} =~ /^(\S+?):(\d+)(?:-(\d+))?$/ or next;
            $to //= $from;

            my $paths = $index{$name};
            if (!$paths) {
                push @stale, [$e, "参照元に $name が見つからない"]; next;
            }
            if (@$paths > 1) {
                push @stale, [$e, "$name が複数ある: " . join(', ', @$paths)]; next;
            }
            my @lines = read_lines($paths->[0]);
            if ($to > @lines) {
                push @stale, [$e, "$name は " . scalar(@lines) . " 行しかない"]; next;
            }
            next if $e->{kind} eq '推理';   # 行の存在だけ見れば足りる

            # 証言。引用は行の一部でよい。エスケープと空白の揺れは吸収する
            # （TS のテンプレートリテラル内は ` が \` になっているなど）。
            my $hay = hay_of(@lines[$from-1 .. $to-1]);
            my $needle = norm($e->{text});
            next unless length $needle && index($hay, $needle) < 0;

            # 合わない。だが「消えた」のか「動いた」のかは別である。
            # 上流がファイルの上のほうに行を足せば、引用は無傷のまま下へずれる。
            # 全体を探して、同じ引用がどこにあるかを言う（弱点3への追加対処）。
            my @hits = find_quote(\@lines, $needle, $to - $from + 1);
            push @stale, [$e, describe_move($name, $from, $to, \@hits), \@hits];
        }
    }
}

# 引用が「今どこにあるか」を探す。
#
# 典拠が合わないとき、原因は二つに分かれる。**引用が消えた**（上流が書き換えた）か、
# **引用が動いた**（上流が上のほうに行を足した）か。前者は文書を直す話だが、
# 後者は行番号を書き換えるだけで済む。区別できれば手間がまるで違う。
#
# 同じ幅の窓をずらしながら探す。ファイルは数千行なので素朴な走査で足りる。
sub find_quote {
    my ($lines, $needle, $span) = @_;
    my @hits;
    for my $i (0 .. @$lines - $span) {
        push @hits, $i + 1 if index(hay_of(@$lines[$i .. $i + $span - 1]), $needle) >= 0;
    }
    return @hits;
}

# 探した結果を人間向けの一文にする。
sub describe_move {
    my ($name, $from, $to, $hits) = @_;
    my $span = $to - $from + 1;
    return "引用が $name:$from に見当たらない（どこにもない。上流が書き換えたか、引用が不正確）"
        if !@$hits;
    if (@$hits == 1) {
        my $new = $hits->[0];
        my $range = $span > 1 ? "$new-" . ($new + $span - 1) : $new;
        return "引用は $name:$range に移動している（$from から " .
               ($new > $from ? "+" : "") . ($new - $from) . " 行）";
    }
    return "引用が $name の複数箇所にある: " . join(', ', @$hits) . "（人が選ぶこと）";
}

# 引用の突き合わせ相手（干し草）を作る。複数行に跨る引用のために、
# **行頭のコメント記号を落としてから連結する**。落とさないと
# 「code sync (one Yjs doc for / the whole workspace)」のような引用が、
# 途中に紛れ込む `//` のせいで一致しない。飾りであって中身ではない。
sub hay_of {
    my @lines = @_;
    return norm(join ' ', map { my $t = $_; $t =~ s{^\s*(?://+|\*+|\#)\s?}{}; $t } @lines);
}

sub norm {                     # 突き合わせ用の正規化
    my $s = shift // '';
    $s =~ s/\\//g;             # バックスラッシュを落とす
    $s =~ s/`//g;              # バッククォートも。出典側は TS のテンプレート
                               # リテラル内で \` になっており、こちらは
                               # Markdown の記法として書く。どちらも飾りなので
                               # 落として中身だけを比べる
    $s =~ s/\s+/ /g;           # 空白の連なりを 1 個に
    $s =~ s/^ | $//g;
    return $s;
}

sub read_lines {
    open(my $h, '<:encoding(UTF-8)', shift) or return ();
    my @l = <$h>; close $h; return @l;
}

# ---- Markdown の引用を突き合わせる ----
#
# `.nw` の証拠は「種類・典拠・記述」の三つ組だが、Markdown の地の文に
# そんな構造はない。あるのは `api.ts:1317-1320` のような引用と、その隣に
# 書かれていることが多い短い逐語である。後者をアンカーと呼ぶ。
#
#   アンカーあり  逐語がその範囲に実在するか（`.nw` の 証言 と同じ強さ）
#   アンカーなし  行が実在するかだけ（`.nw` の 推理 と同じ強さ）
#
# **行の存在だけでは今回の風化は捕まらない。** ずれた先にも行はあったからである。
# だからアンカーのない引用は「未証」と同じ扱いで並べ、足す先を示す。
sub check_markdown {
    my $path = shift;
    die "nwitness: $REF がない。裏取りには参照元が要る（setup.sh を先に）\n" unless -d $REF;
    my %index = build_index($REF);

    open(my $h, '<:encoding(UTF-8)', $path) or die "nwitness: $path: $!\n";
    my @src = <$h>; close $h;

    my (@bad, @loose);
    my ($total, $anchored) = (0, 0);
    my $fenced = 0;

    for my $i (0 .. $#src) {
        my $l = $src[$i];
        if ($l =~ /^\s*```/) { $fenced = !$fenced; next }
        next if $fenced;

        while ($l =~ /`([A-Za-z0-9_.\-]+\.(?:ts|tsx|js|mjs|jsonc)):(\d+)(?:-(\d+))?`/g) {
            my ($name, $from, $to) = ($1, $2, $3 // $2);
            $total++;
            my $where = { line => $i + 1, src => "$name:$from" . ($3 ? "-$3" : "") };

            # アンカーは引用の前後どちらにも書かれうる。前に置く形（引用文を
            # 先に示して括弧で典拠を添える）も実際に使っている。
            my $rest   = substr($l, pos($l));
            my $cont   = ($src[$i+1] // '') . ' ' . ($src[$i+2] // '');
            my $before = substr($l, 0, pos($l) - length("`$name:$from`"));
            my $anchor = anchor_after($rest, $cont) // anchor_before($before);

            my $paths = $index{$name};
            if    (!$paths)      { push @bad, [$where, "参照元に $name が見つからない"]; next }
            elsif (@$paths > 1)  { push @bad, [$where, "$name が複数ある: " . join(', ', @$paths)]; next }

            my @lines = read_lines($paths->[0]);
            if ($to > @lines) {
                push @bad, [$where, "$name は " . scalar(@lines) . " 行しかない"]; next;
            }
            if (!defined $anchor) { push @loose, $where; next }

            $anchored++;
            my $hay = hay_of(@lines[$from-1 .. $to-1]);
            # 「A … B」と省略された引用は、断片ごとに照合する。
            for my $frag (split /…|\.\.\./, $anchor) {
                my $needle = norm($frag);
                next unless length $needle;
                next if index($hay, $needle) >= 0;
                # `.nw` 側と同じく、消えたのか動いたのかを言う。
                my @hits = find_quote(\@lines, $needle, $to - $from + 1);
                push @bad, [$where, describe_move($name, $from, $to, \@hits) .
                                    (@hits ? "" : " — 引用: $needle")];
                last;
            }
        }
    }

    print "$path\n\n";
    printf "  アンカーなし  %s:%d  %s\n", $path, $_->{line}, $_->{src} for @loose;
    print "\n" if @loose;
    printf "引用 %d 件、うちアンカーあり %d / 要確認 %d\n", $total, $anchored, scalar @bad;

    if (@bad) {
        print "\n要確認: 典拠が合わない。上流が変わったか、引用が不正確か。\n";
        for my $b (@bad) {
            my ($w, $why) = @$b;
            printf "      %s:%d  %s\n", $path, $w->{line}, $w->{src};
            printf "        %s\n", $why;
        }
    }
    return @bad ? 1 : 0;
}

# 引用のうしろ: 「— `code`」「に「…」」「に "…"」
#
# 引用符の**開き**は引用と同じ行になければならない。閉じは次行に跨いでよい。
# 跨がせないと、次の行にある別の典拠の引用文を掴んでしまう（実例:
# 「`auto-approval.ts:70-71`。同ファイル 54 行に "…"」で 54 行の引用を
# 70-71 行のアンカーだと誤認した）。
sub anchor_after {
    my ($rest, $cont) = @_;
    return $1 if $rest =~ /^\s*[—–-]\s*`([^`]+)`/;
    for my $q (['「', '」'], ['"', '"']) {
        my ($open, $close) = @$q;
        next unless $rest =~ /^[^\Q$open\E]{0,16}\Q$open\E/;
        my $joined = $rest . ' ' . $cont;
        return $1 if $joined =~ /\Q$open\E([^\Q$close\E]+)\Q$close\E/;
    }
    return undef;
}

sub anchor_before {            # 引用のまえ: 「…」（`file:123`）の形
    my $t = shift;
    return $1 if $t =~ /「([^」]+)」[^「」]{0,4}$/;
    return $1 if $t =~ /"([^"]+)"[^"]{0,4}$/;
    return undef;
}

sub build_index {              # ファイル名 -> パス（node_modules と dist は除く）
    my $root = shift;
    my %ix;
    my @stack = ($root);
    while (my $dir = pop @stack) {
        opendir(my $dh, $dir) or next;
        for my $n (readdir $dh) {
            next if $n eq '.' || $n eq '..';
            next if $n eq 'node_modules' || $n eq 'dist' || $n eq '.git'
                 || $n eq '.wrangler' || $n eq 'generated';
            my $p = "$dir/$n";
            if (-d $p)    { push @stack, $p }
            elsif (-f $p) { push @{$ix{$n}}, $p }
        }
        closedir $dh;
    }
    return %ix;
}

# ---- 集計 ----
my %count;
$count{$_->{kind}}++ for map { @{$_->{ev}} } @sections;
my @unproven = grep { !@{$_->{ev}} && ($_->{title} ne '(冒頭)' || @sections == 1) } @sections;

print "$file\n\n";

for my $s (@sections) {
    next unless $all || !@{$s->{ev}};
    next if $s->{title} eq '(冒頭)' && !@{$s->{ev}} && !$all;
    printf "  %-4s %s\n", @{$s->{ev}} ? "" : "未証", $s->{title};
    for my $e (@{$s->{ev}}) {
        printf "       %s  %s  %s\n", $e->{kind}, $e->{src}, $e->{text};
    }
}

print "\n";
printf "節 %d、うち未証 %d\n", scalar @sections, scalar @unproven;
printf "証拠 物証 %d / 証言 %d / 推理 %d\n",
       $count{'物証'} // 0, $count{'証言'} // 0, $count{'推理'} // 0;

if ($verify) {
    my $checked = grep { $_->{kind} ne '物証' } map { @{$_->{ev}} } @sections;
    printf "裏取り %d 件、うち要確認 %d\n", $checked, scalar @stale;
}

if (@stale) {
    print "\n";
    print "要確認: 典拠が合わない。上流が変わったか、引用が不正確か。\n";
    for my $s (@stale) {
        my ($e, $why) = @$s;
        printf "      %s:%d  %s %s\n", $file, $e->{line}, $e->{kind}, $e->{src};
        printf "        %s\n", $why;
    }
}

if (@misplaced) {
    print "\n";
    print "警告: チャンクの中に \@証 がある。ntangle は平文しか捨てないので、\n";
    print "      これはコードに混入する。チャンクの外へ出すこと。\n";
    printf "      %s:%d\n", $file, $_->{line} for @misplaced;
}

exit 1 if @misplaced || @stale;
