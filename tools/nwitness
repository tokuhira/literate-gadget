#!/usr/bin/env perl
# nwitness - .nw 文書の証拠を集計する。tangle（綯う）/ weave（織る）に対する第三の操作。
#   usage: nwitness [-a] file.nw
#          -a  証拠の付いている節も含めて全部出す（既定は未証の節だけ）
#
# 平文の既定は「未証」である。`@証` の行が置かれたところだけ裏付けが付く。
# 緩く使うなら走らせなければよく、ストイックに使えば未証の節が TODO リストになる。
#
# 記法:
#   @証 <種類> <典拠> <記述>
#
#   物証  実際に動かして観察した。典拠は確認した日付
#   証言  出典が述べている。典拠はファイルと位置。**証人も誤りうるし、
#         こちらが適用範囲を取り違えることもある**（HANDOFF.md §2.10 の実例）
#   推理  コードを読んで導いた。典拠は読んだ範囲
#
# 強さは 物証 > 証言 > 推理 だが、物証も「観察」であって「解釈」ではない。
# 何を見たかは確かでも、なぜそうなるかは別に立証が要る。

use strict; use warnings;
use utf8;
binmode(STDOUT, ':encoding(UTF-8)');

my ($all, $verify) = (0, 0);
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $o = shift;
    if    ($o eq '-a') { $all = 1 }
    elsif ($o eq '-v') { $verify = 1 }
    else  { die "nwitness: 不明なオプション $o\n" }
}
my $file = shift or die "usage: nwitness [-a] [-v] file.nw\n";
open(my $fh, '<:encoding(UTF-8)', $file) or die "nwitness: $file: $!\n";

my @sections;                      # { title, line, ev => [...] }
my $cur = { title => '(冒頭)', line => 0, ev => [] };
my $in_chunk = 0;
my @misplaced;                     # チャンクの中に置かれた @証（コードに漏れる）

while (my $l = <$fh>) {
    my $n = $.;
    if ($l =~ /^<<(.+)>>=\s*$/)          { $in_chunk = 1; next; }
    if ($in_chunk && $l =~ /^\@\s*$/)    { $in_chunk = 0; next; }

    if ($in_chunk) {
        # チャンク内の @証 は ntangle に素通しされ、コードに混入する。
        push @misplaced, { line => $n, text => $l } if $l =~ /^\s*\@証\b/;
        next;
    }

    if ($l =~ /^##+\s+(.*?)\s*$/) {      # 節の切れ目
        push @sections, $cur;
        $cur = { title => $1, line => $n, ev => [] };
        next;
    }
    if ($l =~ /^\@証\s+(\S+)\s+(\S+)\s*(.*?)\s*$/) {
        push @{$cur->{ev}}, { kind => $1, src => $2, text => $3, line => $n };
        next;
    }
}
push @sections, $cur;
close $fh;

# ---- 裏取り（-v）----
#
# 証言は「上流がこう言っている」という主張なので、上流が変われば古びる。
# 引用文が本当にその行にあるかを突き合わせる。これが弱点3（証拠の風化）への対処。
#
# 種類ごとに検査できることが違う:
#   証言  引用文がその行に実在するか
#   推理  本文はこちらの推論なので、行が実在するかだけ
#   物証  典拠は日付。突き合わせる相手がない
my $REF = 'reference/cloudflare-os';
my @stale;
if ($verify) {
    if (!-d $REF) {
        die "nwitness: $REF がない。裏取りには参照元が要る（setup.sh を先に）\n";
    }
    my %index = build_index($REF);
    for my $s (@sections) {
        for my $e (@{$s->{ev}}) {
            next if $e->{kind} eq '物証';
            my ($name, $from, $to) = $e->{src} =~ /^(\S+?):(\d+)(?:-(\d+))?$/ or next;
            $to //= $from;

            my $paths = $index{$name};
            if (!$paths) {
                push @stale, [$e, "参照元に $name が見つからない"]; next;
            }
            if (@$paths > 1) {
                push @stale, [$e, "$name が複数ある: " . join(', ', @$paths)]; next;
            }
            my @lines = read_lines($paths->[0]);
            if ($to > @lines) {
                push @stale, [$e, "$name は " . scalar(@lines) . " 行しかない"]; next;
            }
            next if $e->{kind} eq '推理';   # 行の存在だけ見れば足りる

            # 証言。引用は行の一部でよい。エスケープと空白の揺れは吸収する
            # （TS のテンプレートリテラル内は ` が \` になっているなど）。
            my $hay = norm(join ' ', @lines[$from-1 .. $to-1]);
            my $needle = norm($e->{text});
            push @stale, [$e, "引用が $name:$from に見当たらない"]
                if length $needle && index($hay, $needle) < 0;
        }
    }
}

sub norm {                     # 突き合わせ用の正規化
    my $s = shift // '';
    $s =~ s/\\//g;             # バックスラッシュを落とす
    $s =~ s/`//g;              # バッククォートも。出典側は TS のテンプレート
                               # リテラル内で \` になっており、こちらは
                               # Markdown の記法として書く。どちらも飾りなので
                               # 落として中身だけを比べる
    $s =~ s/\s+/ /g;           # 空白の連なりを 1 個に
    $s =~ s/^ | $//g;
    return $s;
}

sub read_lines {
    open(my $h, '<:encoding(UTF-8)', shift) or return ();
    my @l = <$h>; close $h; return @l;
}

sub build_index {              # ファイル名 -> パス（node_modules と dist は除く）
    my $root = shift;
    my %ix;
    my @stack = ($root);
    while (my $dir = pop @stack) {
        opendir(my $dh, $dir) or next;
        for my $n (readdir $dh) {
            next if $n eq '.' || $n eq '..';
            next if $n eq 'node_modules' || $n eq 'dist' || $n eq '.git'
                 || $n eq '.wrangler' || $n eq 'generated';
            my $p = "$dir/$n";
            if (-d $p)    { push @stack, $p }
            elsif (-f $p) { push @{$ix{$n}}, $p }
        }
        closedir $dh;
    }
    return %ix;
}

# ---- 集計 ----
my %count;
$count{$_->{kind}}++ for map { @{$_->{ev}} } @sections;
my @unproven = grep { !@{$_->{ev}} && ($_->{title} ne '(冒頭)' || @sections == 1) } @sections;

print "$file\n\n";

for my $s (@sections) {
    next unless $all || !@{$s->{ev}};
    next if $s->{title} eq '(冒頭)' && !@{$s->{ev}} && !$all;
    printf "  %-4s %s\n", @{$s->{ev}} ? "" : "未証", $s->{title};
    for my $e (@{$s->{ev}}) {
        printf "       %s  %s  %s\n", $e->{kind}, $e->{src}, $e->{text};
    }
}

print "\n";
printf "節 %d、うち未証 %d\n", scalar @sections, scalar @unproven;
printf "証拠 物証 %d / 証言 %d / 推理 %d\n",
       $count{'物証'} // 0, $count{'証言'} // 0, $count{'推理'} // 0;

if ($verify) {
    my $checked = grep { $_->{kind} ne '物証' } map { @{$_->{ev}} } @sections;
    printf "裏取り %d 件、うち要確認 %d\n", $checked, scalar @stale;
}

if (@stale) {
    print "\n";
    print "要確認: 典拠が合わない。上流が変わったか、引用が不正確か。\n";
    for my $s (@stale) {
        my ($e, $why) = @$s;
        printf "      %s:%d  %s %s\n", $file, $e->{line}, $e->{kind}, $e->{src};
        printf "        %s\n", $why;
    }
}

if (@misplaced) {
    print "\n";
    print "警告: チャンクの中に \@証 がある。ntangle は平文しか捨てないので、\n";
    print "      これはコードに混入する。チャンクの外へ出すこと。\n";
    printf "      %s:%d\n", $file, $_->{line} for @misplaced;
}

exit 1 if @misplaced || @stale;
